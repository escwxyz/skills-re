# https://developers.cloudflare.com/sandbox/configuration/dockerfile/#base-images
# match with the npm sdk package
ARG SANDBOX_BASE_IMAGE=docker.io/cloudflare/sandbox:0.10.1
FROM ${SANDBOX_BASE_IMAGE}

ARG OPENCODE_VERSION=latest
ARG AGENT_SKILLS_EVAL_VERSION=0.1.1

USER root

COPY src/skill-eval-sandbox/container/agent-skills-eval-runner.mjs /usr/local/bin/skills-re-agent-skills-eval-runner.mjs

RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" \
  && opencode --version

RUN npm install -g "agent-skills-eval@${AGENT_SKILLS_EVAL_VERSION}" \
  && agent-skills-eval --help >/dev/null

RUN npm install -g @openai/codex \
  && codex --version

RUN npm install -g @anthropic-ai/claude-code \
  && claude --version

RUN chmod +x /usr/local/bin/skills-re-agent-skills-eval-runner.mjs

ENV SKILLS_RE_EVAL_AGENT=opencode
ENV PYTHON_POOL_MIN_SIZE=0
ENV JAVASCRIPT_POOL_MIN_SIZE=3
ENV TYPESCRIPT_POOL_MIN_SIZE=3

WORKDIR /workspace

ENTRYPOINT ["/container-server/sandbox"]
