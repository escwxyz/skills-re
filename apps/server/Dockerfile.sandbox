# https://developers.cloudflare.com/sandbox/configuration/dockerfile/#base-images
# match with the npm sdk package
ARG SANDBOX_BASE_IMAGE=docker.io/cloudflare/sandbox:0.10.1
FROM ${SANDBOX_BASE_IMAGE}

ARG OPENCODE_VERSION=latest

USER root

RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" \
  && opencode --version

RUN npm install -g @openai/codex \
  && codex --version

RUN npm install -g @anthropic-ai/claude-code \
  && claude --version

ENV SKILLS_RE_EVAL_AGENT=opencode
ENV PYTHON_POOL_MIN_SIZE=0
ENV JAVASCRIPT_POOL_MIN_SIZE=3
ENV TYPESCRIPT_POOL_MIN_SIZE=3

WORKDIR /workspace

ENTRYPOINT ["/container-server/sandbox"]
