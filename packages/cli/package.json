{
  "name": "@skills-re/cli",
  "version": "0.0.1",
  "description": "Command-line client for discovering, installing, locking, and exposing skills.re skills.",
  "author": {
    "name": "Jie Wang",
    "email": "hi@jiewa.ng",
    "url": "https://github.com/escwxyz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/escwxyz/skills-re.git"
  },
  "bin": {
    "skills-re": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "modern-tar": "^0.7.6",
    "picocolors": "^1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@skills-re/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
